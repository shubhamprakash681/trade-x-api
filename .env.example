# Copy this file to .env and replace every example secret before starting Compose.
# Values here are defaults for Docker Compose; every key can still be overridden.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
TRADEX_JWT_SECRET=

# PgAdmin config - Only for running locally
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Cofig Server
CONFIG_SERVER_PORT=8888
CONFIG_SERVER_URL=http://localhost:8888

# Eureka Server Configuration
EUREKA_SERVER_PORT=8761
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# The gateway is the only service exposed to the host by default in Compose.
API_GATEWAY_PORT=8080
GATEWAY_CONNECT_TIMEOUT_MS=3000
GATEWAY_RESPONSE_TIMEOUT=10s

# Infrastructure (host defaults are useful when running services outside Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=tradex
RABBITMQ_PASSWORD=replace-with-a-long-random-password

# Database schema management. Leave at update for the first empty database
# startup; use validate after introducing versioned migrations in deployment.
JPA_DDL_AUTO=update

# Auth Service
AUTH_SERVICE_PORT=8081
AUTH_POSTGRES_DB=
AUTH_DB_URL=
AUTH_DB_USERNAME=
AUTH_DB_PASSWORD=
AUTH_EMAIL_FROM=
AUTH_EMAIL_PASSWORD=

# Market Service
MARKET_SERVICE_PORT=8082
MARKET_POSTGRES_DB=
MARKET_DB_URL=
MARKET_DB_USERNAME=
MARKET_DB_PASSWORD=
TRADEX_PRICE_TOPIC=tradex.market.prices
TRADEX_MARKET_HISTORY_YEARS=10
TRADEX_MARKET_HISTORY_INTERVAL=DAILY

# Portfolio Service
PORTFOLIO_SERVICE_PORT=8083
PORTFOLIO_POSTGRES_DB=
PORTFOLIO_DB_URL=
PORTFOLIO_DB_USERNAME=
PORTFOLIO_DB_PASSWORD=
TRADEX_STARTING_CASH=1000000.00

# Price Stream Service
PRICE_STREAM_SERVICE_PORT=8084
PRICE_STREAM_POSTGRES_DB=
PRICE_STREAM_DB_URL=
PRICE_STREAM_DB_USERNAME=
PRICE_STREAM_DB_PASSWORD=
TRADEX_PRICE_GENERATION_INTERVAL_MS=2000
TRADEX_PRICE_HISTORY_LIMIT=500
TRADEX_PRICE_SYMBOLS=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK,SBIN,ITC,LT,AXISBANK,BHARTIARTL,MARUTI,TITAN,ASIANPAINT,NIFTYBEES,BANKBEES

# Notification Service
NOTIFICATION_SERVICE_PORT=8085
NOTIFICATION_POSTGRES_DB=
NOTIFICATION_DB_URL=
NOTIFICATION_DB_USERNAME=
NOTIFICATION_DB_PASSWORD=
TRADEX_WATCHLIST_CACHE_TTL_MINUTES=10
TRADEX_NOTIFICATION_LIMIT=100
